{
  "name": "@fm618/oa-worklog",
  "version": "0.1.0",
  "private": true,
  "description": "工作日志模块（dual-face）：列表 / 新建 / 编辑 / 删除",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    }
  },
  "scripts": {
    "build": "tsc -b && node scripts/build-client.mjs",
    "clean": "rm -rf dist lib"
  },
  "devDependencies": {
    "@fm618/oa-runtime": "workspace:^",
    "@fm618/plugin-kit": "workspace:^",
    "@deepseek-ai/cordis": "^4.0.2",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.5.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@fm618/oa-runtime"
      ],
      "platform": "web"
    }
  },
  "files": [
    "dist",
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "NOTICE"
  ],
  "peerDependencies": {
    "@fm618/oa-runtime": "^0.1.0"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "无锡星环智能信息科技有限公司",
    "url": "https://www.fm618.com"
  },
  "homepage": "https://www.fm618.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FM618/oa-plugin.git",
    "directory": "plugins/oa-worklog"
  },
  "bugs": {
    "url": "https://github.com/FM618/oa-plugin/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "oa",
    "worklog",
    "gantt",
    "timesheet"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
