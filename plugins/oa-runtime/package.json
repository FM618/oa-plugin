{
  "name": "@fm618/oa-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "OA 运行时：连接、登录、令牌、能力、导航（dual-face）",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    }
  },
  "scripts": {
    "build": "tsc -b && node scripts/build-client.mjs",
    "clean": "rm -rf dist lib"
  },
  "dependencies": {},
  "devDependencies": {
    "@fm618/plugin-kit": "workspace:^",
    "@deepseek-ai/cordis": "^4.0.2",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.5.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "files": [
    "dist",
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "NOTICE"
  ],
  "peerDependencies": {
    "@fm618/plugin-kit": "^0.1.0"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "无锡星环智能信息科技有限公司",
    "url": "https://github.com/FM618"
  },
  "homepage": "https://github.com/FM618",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FM618/oa-plugin.git",
    "directory": "plugins/oa-runtime"
  },
  "bugs": {
    "url": "https://github.com/FM618/oa-plugin/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "oa",
    "runtime",
    "login",
    "oauth-client"
  ],
  "publishConfig": {
    "access": "public"
  }
}
